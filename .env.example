# ===== Supabase 云端底座 =====
# 在 Supabase 控制台 -> Project Settings -> API 获取
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ===== AI 内容生成（DeepSeek）=====
# Supabase Edge Functions 调用大模型时使用，写入 Supabase 的 Secrets，不要暴露在前端
DEEPSEEK_API_KEY=your-deepseek-api-key

# ===== 天气（和风天气，国内定位更准）=====
# https://dev.qweather.com/ 注册获取；也可用 OpenWeatherMap
QWEATHER_API_KEY=your-qweather-api-key

# ===== RSS / 第三方聚合源（后端代理抓取用）=====
# 可留空，由 Edge Functions 使用默认源；需要时在此覆盖
RSS_PROXY_BASE=https://your-project-ref.supabase.co/functions/v1
