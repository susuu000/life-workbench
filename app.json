{
  "expo": {
    "name": "月夕",
    "slug": "life-workbench",
    "scheme": "lifeworkbench",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./public/icons/icon-192x192.svg",
    "splash": {
      "image": "./public/splash/splash-iphone_14_pro_max.svg",
      "resizeMode": "contain",
      "backgroundColor": "#2E6F7E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourorg.lifeworkbench"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/favicon.svg",
      "manifest": {
        "name": "月夕生活台",
        "short_name": "月夕",
        "description": "个人生活工作台 · 记录每一天的成长",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#f5e6d3",
        "theme_color": "#2E6F7E",
        "start_url": "/",
        "icons": [
          {
            "src": "/icons/icon-192x192.svg",
            "sizes": "192x192",
            "type": "image/svg+xml",
            "purpose": "any maskable"
          },
          {
            "src": "/icons/icon-512x512.svg",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/life-workbench"
    }
  }
}
