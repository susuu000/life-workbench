{
  "expo": {
    "name": "月夕",
    "slug": "life-workbench",
    "scheme": "lifeworkbench",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E6F7E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourorg.lifeworkbench"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "manifest": {
        "name": "月夕生活台",
        "short_name": "月夕",
        "description": "个人生活工作台 · 记录每一天的成长",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#f5e6d3",
        "theme_color": "#2E6F7E",
        "start_url": "/",
        "icons": [
          {
            "src": "/assets/icon.png",
            "sizes": "1024x1024",
            "type": "image/png",
            "purpose": "any"
          }
        ]
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/life-workbench"
    }
  }
}
