{
  "name": "life-workbench",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "月夕生活台 v3 — CodeBuddy 风格优化版",
  "main": "expo-router/entry",
  "scheme": "lifeworkbench",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "supabase:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "supabase:push": "supabase db push"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "@opentelemetry/api": "^1.9.0",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "react-native-web": "~0.19.13",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eas-cli": "^12.0.0",
    "supabase": "^1.0.0",
    "typescript": "~5.6.3"
  }
}
